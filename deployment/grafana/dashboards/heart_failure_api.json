{
  "uid": "heart-failure-api",
  "title": "Heart Failure API — Serving Overview",
  "description": "Live health, traffic, latency and prediction mix for the FastAPI heart failure classifier. Data source: Prometheus scraping http://localhost:8000/metrics.",
  "tags": ["mlops", "fastapi", "heart-failure"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API scrape status",
      "description": "Prometheus `up` for the heart-failure-api job. DOWN means the scrape itself failed.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "up{job=\"heart-failure-api\"}",
          "instant": true,
          "legendFormat": "up"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 1 },
                "1": { "text": "UP", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model loaded",
      "description": "heart_failure_model_loaded — the service can be up while the model is missing.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "heart_failure_model_loaded",
          "instant": true,
          "legendFormat": "model"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "NOT LOADED", "color": "red", "index": 1 },
                "1": { "text": "READY", "color": "green", "index": 0 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "description": "Seconds since the FastAPI process started serving.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "heart_failure_app_uptime_seconds",
          "instant": true,
          "legendFormat": "uptime"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Predictions served",
      "description": "Cumulative prediction requests since the process started, all outcomes.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(heart_failure_prediction_requests_total)",
          "instant": true,
          "legendFormat": "requests"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failure ratio (5m)",
      "description": "Share of prediction requests that failed over the last 5 minutes. Mirrors the HighPredictionFailureRate alert (>10%).",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(heart_failure_prediction_requests_total{status=\"failure\"}[5m])) / clamp_min(sum(rate(heart_failure_prediction_requests_total[5m])), 0.001)",
          "instant": true,
          "legendFormat": "failure ratio"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "p95 latency (5m)",
      "description": "95th percentile end-to-end prediction latency. Mirrors the HighPredictionLatency alert (>500ms).",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(heart_failure_prediction_latency_seconds_bucket[5m])) by (le))",
          "instant": true,
          "legendFormat": "p95"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prediction request rate by outcome",
      "description": "Requests per second reaching /predict, split into success and failure.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (status) (rate(heart_failure_prediction_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Prediction latency percentiles",
      "description": "Computed from heart_failure_prediction_latency_seconds_bucket over a 5m window. One axis: all three series share the same unit.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(heart_failure_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(heart_failure_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(heart_failure_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 0.5 }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "HTTP request rate by endpoint",
      "description": "Every route the API serves, labelled by route template rather than raw path.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (endpoint) (rate(heart_failure_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Predicted class mix",
      "description": "Predictions per second by predicted class — a cheap drift signal: a sudden shift in the mix usually means the input distribution moved.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (predicted_class) (rate(heart_failure_predictions_by_class_total[$__rate_interval]))",
          "legendFormat": "{{predicted_class}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Prediction failures by reason",
      "description": "Failures counted in the last 5 minutes, split by cause: validation_error, model_not_loaded or inference_error.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (reason) (increase(heart_failure_prediction_failures_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "HTTP responses by status code",
      "description": "Response codes per second. Anything other than 2xx appearing here is worth a look.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (http_status) (rate(heart_failure_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{http_status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Request batch size percentiles",
      "description": "Instances submitted per prediction request. Large batches explain latency spikes that are not a model problem.",
      "datasource": { "type": "prometheus", "uid": "prometheus-hf" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(heart_failure_prediction_batch_size_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(heart_failure_prediction_batch_size_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    }
  ]
}
